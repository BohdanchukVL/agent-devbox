# devbox.env.example
#
# This file documents the provisioning flags that end up on the machine
# at /etc/devbox/devbox.env. It is generated automatically from the
# Terraform variables (which in turn come from the GitHub Actions inputs),
# so you normally never edit it by hand — it is here as a reference.

# The unprivileged user created on the machine (has passwordless sudo).
DEVBOX_USER=dev

# Install Docker Engine + Docker Compose plugin.
INSTALL_DOCKER=true

# Install OpenAI Codex CLI (`codex`).
INSTALL_CODEX=true

# Install Anthropic Claude Code (`claude`).
INSTALL_CLAUDE=true

# Install OpenCode (`opencode`).
INSTALL_OPENCODE=false

# Install Google Antigravity CLI (`agy`). Standalone binary → ~/.local/bin;
# authenticates over SSH via a device URL + code.
INSTALL_ANTIGRAVITY=true

# Install a headless browser (Playwright + Chromium) so agents can run
# E2E tests and take screenshots against web projects.
INSTALL_BROWSER=true

# Block device to format & mount at /workspace (set automatically on
# Hetzner when a separate volume is attached; empty = workspace lives
# on the root disk).
WORKSPACE_DEVICE=

# Tailscale auth key (optional). If set, the machine automatically joins
# your Tailnet on boot with Tailscale SSH and hostname "agent-devbox".
# Automatically scrubbed from disk immediately after tailscale up.
TAILSCALE_AUTHKEY=

# Authentication token for devbox-web companion gateway (optional).
# If omitted, a random 32-character hex token is generated at boot
# and saved to ~/.devbox/web.env (permissions 0600).
DEVBOX_WEB_TOKEN=

# GitHub repository (owner/repo) to download provisioning scripts from
# when PROVISIONING_TARBALL_URL is not set.
PROVISIONING_REPO=

# Git ref (branch, tag, or commit SHA) corresponding to PROVISIONING_REPO.
PROVISIONING_REF=main

# Optional GitHub PAT for private repository provisioning payloads.
# Automatically scrubbed from disk after payload archive extraction.
PROVISIONING_TOKEN=

# Optional SHA256 checksum to verify downloaded provisioning tarball archive.
PROVISIONING_SHA256=

# Optional direct URL (e.g. S3 presigned URL) to a provisioning tarball archive.
PROVISIONING_TARBALL_URL=

# Set to true to disable automatic loading of production database credentials
# from .env in MCP database queries.
DEVBOX_DB_DISABLE_ENV=false


# versions.env — single source of truth for all tool versions
# Updated manually or via Renovate (see renovate.json)
#
# Convention: TOOL_VERSION holds the version string, TOOL_SHA256 (optional)
# holds the checksum for binary downloads.

# ── Base tools ────────────────────────────────────────────────────────────
NODE_MAJOR=22
PNPM_VERSION=9.15.9

# ── Shell tools ───────────────────────────────────────────────────────────
YQ_VERSION=v4.44.3
LAZYGIT_VERSION=0.44.1
STARSHIP_VERSION=1.22.1
ZOXIDE_VERSION=0.9.7

# ── Agents (npm packages) ────────────────────────────────────────────────
CLAUDE_CODE_VERSION=latest
CODEX_VERSION=latest
OPENCODE_VERSION=latest

# ── MCP tools (npm packages) ─────────────────────────────────────────────
AST_GREP_CLI_VERSION=latest
AST_GREP_MCP_VERSION=latest
MCP_SERVER_MEMORY_VERSION=latest
PLAYWRIGHT_MCP_VERSION=latest
PLAYWRIGHT_VERSION=latest

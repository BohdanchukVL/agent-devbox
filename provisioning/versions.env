# versions.env — single source of truth for all tool versions
# Updated manually or via Renovate (see renovate.json)
#
# Release channel: 'stable' uses these pinned versions;
# 'latest' installs latest available upstream.

# ── Base tools ────────────────────────────────────────────────────────────
NODE_MAJOR=22
PNPM_VERSION=9.15.9
DOCKER_VERSION=27.5.1
TAILSCALE_VERSION=1.80.3

# ── Shell tools ───────────────────────────────────────────────────────────
YQ_VERSION=v4.44.3
LAZYGIT_VERSION=0.44.1
STARSHIP_VERSION=1.22.1

# ── Agents (npm packages) ────────────────────────────────────────────────
# In stable channel, CLI tools default to pinned releases or latest
CLAUDE_CODE_VERSION=2.1.270
CODEX_VERSION=0.154.0
OPENCODE_VERSION=1.18.30

# ── MCP tools & Playwright ───────────────────────────────────────────────
AST_GREP_VERSION=0.38.1
AST_GREP_MCP_VERSION=0.1.7
MCP_MEMORY_VERSION=0.6.2
PLAYWRIGHT_MCP_VERSION=0.0.32
PLAYWRIGHT_VERSION=1.51.0
